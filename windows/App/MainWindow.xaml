<Window x:Class="BarelyReal.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BarelyReal.App.Controls"
        Title="BarelyReal"
        Icon="Assets/BarelyReal.ico"
        Width="1100"
        Height="760"
        MinWidth="940"
        MinHeight="640"
        Background="#0E1117"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <!-- Brushes -->
        <SolidColorBrush x:Key="TextBrush" Color="#E8EEF7" />
        <SolidColorBrush x:Key="MutedBrush" Color="#A0ADBD" />
        <SolidColorBrush x:Key="DimBrush" Color="#738195" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#263241" />
        <SolidColorBrush x:Key="BorderBrushFaint" Color="#1A2230" />
        <SolidColorBrush x:Key="CardBrush" Color="#131A23" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#0F151D" />
        <SolidColorBrush x:Key="AccentBrush" Color="#7FA7FF" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#17253C" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#49D17D" />
        <SolidColorBrush x:Key="SuccessSoftBrush" Color="#143A2A" />
        <SolidColorBrush x:Key="WarningBrush" Color="#D9B75A" />
        <SolidColorBrush x:Key="WarningSoftBrush" Color="#3E3218" />
        <SolidColorBrush x:Key="DangerBrush" Color="#F36B5F" />
        <SolidColorBrush x:Key="SidebarBrush" Color="#090D13" />
        <SolidColorBrush x:Key="HeroBrush" Color="#123523" />
        <SolidColorBrush x:Key="HeroBorderBrush" Color="#24593C" />

        <!-- Card -->
        <Style x:Key="Card" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="StatBadge" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushFaint}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,14" />
        </Style>

        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!-- Default button (subtle) -->
        <Style TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="Background" Value="#1B2330" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="root" Value="#243044" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" TargetName="root" Value="#1A2230" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary action button -->
        <Style x:Key="PrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="20,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              TextBlock.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="root" Value="#78B6FF" />
                                <Setter Property="BorderBrush" TargetName="root" Value="#78B6FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" TargetName="root" Value="#4F95E6" />
                                <Setter Property="BorderBrush" TargetName="root" Value="#4F95E6" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              TextBlock.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="root" Value="#FF7D72" />
                                <Setter Property="BorderBrush" TargetName="root" Value="#FF7D72" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" TargetName="root" Value="#D85D53" />
                                <Setter Property="BorderBrush" TargetName="root" Value="#D85D53" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar nav RadioButton styled as nav row -->
        <Style x:Key="NavRadio" TargetType="{x:Type RadioButton}">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="root"
                                CornerRadius="7"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border x:Name="indicator"
                                        Width="3"
                                        Height="18"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource AccentBrush}"
                                        CornerRadius="2"
                                        Visibility="Collapsed"
                                        Margin="-12,0,0,0" />
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="root" Value="#151D2A" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" TargetName="root" Value="#1B2638" />
                                <Setter Property="Visibility" TargetName="indicator" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mode pill RadioButton -->
        <Style x:Key="PillRadio" TargetType="{x:Type RadioButton}">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="root"
                                CornerRadius="7"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="root" Value="#202A3A" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" TargetName="root" Value="#273449" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#0F151F" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentSoftBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#0F151F" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        </Style>

        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="{x:Type PasswordBox}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#0F151F" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrushFaint}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <!-- App brand -->
                <StackPanel DockPanel.Dock="Top" Margin="20,42,20,30" HorizontalAlignment="Center">
                    <Border Width="56" Height="56" CornerRadius="14" Background="#263CCF" BorderBrush="#4768FF" BorderThickness="1" Margin="0,0,0,14">
                        <TextBlock Text="▭" Foreground="#8FB4FF" FontWeight="SemiBold" FontSize="34"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="BarelyReal" FontWeight="SemiBold" FontSize="18" HorizontalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0" HorizontalAlignment="Center">
                            <Ellipse x:Name="SidebarStatusDot" Width="8" Height="8" Fill="#BFBFBF" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="SidebarStatusText" Text="Connected" Foreground="{StaticResource MutedBrush}" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Footer session actions -->
                <Border DockPanel.Dock="Bottom" Padding="14" BorderBrush="{StaticResource BorderBrushFaint}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <Border Padding="12" CornerRadius="8" Background="#101722" BorderBrush="{StaticResource BorderBrushFaint}" BorderThickness="1" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Session" Foreground="{StaticResource DimBrush}" FontSize="10" FontWeight="SemiBold" />
                                <TextBlock Text="LAN handoff ready" FontWeight="SemiBold" FontSize="13" Margin="0,5,0,0" />
                                <TextBlock x:Name="FooterText" Text="" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Content="Settings" Padding="8,5" MinHeight="28" Margin="0,0,4,0" Click="SidebarSettings_Click" />
                            <Button Grid.Column="1" Content="Help" Padding="8,5" MinHeight="28" Margin="4,0,0,0" Click="SidebarHelp_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Nav items -->
                <StackPanel Margin="10,0">
                    <RadioButton x:Name="NavHome" Style="{StaticResource NavRadio}" GroupName="Nav" IsChecked="True" Checked="Nav_Changed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡" FontSize="21" Width="34" VerticalAlignment="Center" />
                            <StackPanel>
                                <TextBlock Text="Handoff" FontWeight="SemiBold" />
                                <TextBlock Text="Control devices" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            </StackPanel>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavDisplays" Style="{StaticResource NavRadio}" GroupName="Nav" Checked="Nav_Changed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▱" FontSize="22" Width="34" VerticalAlignment="Center" />
                            <StackPanel>
                                <TextBlock Text="Displays" FontWeight="SemiBold" />
                                <TextBlock Text="Manage screens" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            </StackPanel>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavClipboard" Style="{StaticResource NavRadio}" GroupName="Nav" Checked="Nav_Changed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▣" FontSize="19" Width="34" VerticalAlignment="Center" />
                            <StackPanel>
                                <TextBlock Text="Clipboard" FontWeight="SemiBold" />
                                <TextBlock Text="Shared history" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            </StackPanel>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavActivity" Style="{StaticResource NavRadio}" GroupName="Nav" Checked="Nav_Changed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌁" FontSize="23" Width="34" VerticalAlignment="Center" />
                            <StackPanel>
                                <TextBlock Text="Telemetry" FontWeight="SemiBold" />
                                <TextBlock Text="System logs" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            </StackPanel>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavRadio}" GroupName="Nav" Checked="Nav_Changed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" FontSize="20" Width="34" VerticalAlignment="Center" />
                            <StackPanel>
                                <TextBlock Text="System" FontWeight="SemiBold" />
                                <TextBlock Text="Ports &amp; settings" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            </StackPanel>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Detail -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Grid.Row="0" Background="#0F151D" BorderBrush="{StaticResource BorderBrushFaint}" BorderThickness="0,0,0,1" Padding="30,18">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitleText"
                                   Text="Handoff Center"
                                   FontSize="24"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Seamless control, clipboard, and displays between your devices." Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,4,0,0" />
                    </StackPanel>
                    <Border DockPanel.Dock="Right" CornerRadius="16" Padding="12,7" Background="#111A25" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#BFBFBF" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Connection health" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText" Text="Stopped" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <!-- Pages -->
            <Grid Grid.Row="1">
                <!-- HOME -->
                <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto" Padding="0">
                    <StackPanel MaxWidth="980" Margin="30,24,30,30" HorizontalAlignment="Stretch">

                        <!-- Mode pill -->
                        <Border CornerRadius="8" Background="#0C121A" BorderBrush="{StaticResource BorderBrushFaint}" BorderThickness="1" Padding="3" HorizontalAlignment="Stretch" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <RadioButton x:Name="ModeReceiveRadio"
                                             GroupName="ModeGroup"
                                             IsChecked="True"
                                             Checked="ModeRadio_Changed"
                                             Style="{StaticResource PillRadio}"
                                             Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Mac  ->  Windows" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="ModeSendRadio"
                                             GroupName="ModeGroup"
                                             Checked="ModeRadio_Changed"
                                             Style="{StaticResource PillRadio}"
                                             Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Windows  ->  Mac" />
                                    </StackPanel>
                                </RadioButton>
                            </Grid>
                        </Border>

                        <!-- Status hero -->
                        <Border Style="{StaticResource Card}" Padding="24" CornerRadius="8" Background="{StaticResource HeroBrush}" BorderBrush="{StaticResource HeroBorderBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="64" Height="64" CornerRadius="8" Background="#173F2A" BorderBrush="#2F6F4B" BorderThickness="1" Margin="0,0,18,0">
                                    <TextBlock x:Name="HeroIcon" Text="●" FontSize="30" Foreground="{StaticResource SuccessBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="HANDOFF ACTIVE" Foreground="#8DE8AD" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,5" />
                                    <TextBlock x:Name="HeroTitle" Text="Ready for Mac handoff" FontSize="24" FontWeight="SemiBold" />
                                    <TextBlock x:Name="HeroSubtitle"
                                               Text="Keyboard, mouse, and clipboard routing are staged for this Windows device."
                                               Foreground="#B9D7C4"
                                               Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="StartButton" Content="Start Handoff" Style="{StaticResource PrimaryButton}" Click="StartButton_Click" Margin="0,0,8,0" MinWidth="116" />
                                    <Button x:Name="StopButton" Content="Stop Handoff" Style="{StaticResource DangerButton}" Click="StopButton_Click" MinWidth="116" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Quick stats -->
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource StatBadge}" Margin="0,0,7,0">
                                <StackPanel>
                                    <TextBlock Text="Keyboard &amp; Mouse" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                    <TextBlock x:Name="FramesText" Text="0" FontSize="21" FontWeight="SemiBold" Margin="0,5,0,0" />
                                    <TextBlock Text="Low latency" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource StatBadge}" Margin="7,0,7,0">
                                <StackPanel>
                                    <TextBlock Text="Clipboard" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                    <TextBlock x:Name="ClipboardText" Text="0" FontSize="21" FontWeight="SemiBold" Margin="0,5,0,0" />
                                    <TextBlock Text="Real-time" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource StatBadge}" Margin="7,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Displays" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                    <TextBlock x:Name="LinkText" Text="—" FontSize="21" FontWeight="SemiBold" Margin="0,5,0,0" />
                                    <TextBlock Text="Active" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Connection card (per mode) -->
                        <Border x:Name="ReceiveCard" Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,10">
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="Target device" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock Text="Mac source details for the active Mac-to-Windows session." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Border DockPanel.Dock="Right" CornerRadius="8" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushFaint}" BorderThickness="1" Padding="10,5" VerticalAlignment="Top">
                                        <TextBlock Text="MAC -> WINDOWS" Foreground="{StaticResource DimBrush}" FontSize="10" FontWeight="SemiBold" />
                                    </Border>
                                </DockPanel>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Control channel" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="TCP " VerticalAlignment="Center" />
                                            <TextBox x:Name="ControlPortBox" Text="24800" Width="74" Padding="8,4" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                        <TextBlock Text="Keyboard &amp; mouse" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="UDP " VerticalAlignment="Center" />
                                            <TextBox x:Name="KmPortBox" Text="24801" Width="74" Padding="8,4" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Margin="8,0,8,0">
                                        <TextBlock Text="Clipboard" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="TCP " VerticalAlignment="Center" />
                                            <TextBox x:Name="ClipboardPortBox" Text="24802" Width="74" Padding="8,4" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Margin="8,0,0,0">
                                        <TextBlock Text="Target Mac" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                        <TextBox x:Name="ClipboardPeerBox" Text="192.168.0.101" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                                <Border Margin="0,12,0,0" Padding="12,9" CornerRadius="8" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushFaint}" BorderThickness="1">
                                    <TextBlock x:Name="DiscoveryStatusText"
                                               Text="Discovery starting..."
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border x:Name="SendCard" Style="{StaticResource Card}" Margin="0,14,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,12">
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="Target device" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock Text="Move your cursor past the mapped display edge to control the Mac."
                                                   Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border DockPanel.Dock="Right" CornerRadius="8" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushFaint}" BorderThickness="1" Padding="10,5" VerticalAlignment="Top">
                                        <TextBlock Text="WINDOWS -> MAC" Foreground="{StaticResource DimBrush}" FontSize="10" FontWeight="SemiBold" />
                                    </Border>
                                </DockPanel>

                                <controls:LayoutCanvas x:Name="LayoutDesigner" Margin="0,0,0,16" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Mac IP" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                        <TextBox x:Name="SendMacHostBox" Margin="0,4,0,0" Text="192.168.0.101" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="Mac KM port" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                        <TextBox x:Name="SendMacKmPortBox" Margin="0,4,0,0" Text="24801" />
                                    </StackPanel>
                                </Grid>

                                <Border Margin="0,16,0,0" Padding="14" CornerRadius="8" Background="#211D14" BorderBrush="#4A3C1D" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Wake target" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <TextBox Grid.Column="1" x:Name="WolMacBox" Text="" FontFamily="Cascadia Mono, Consolas" Margin="0,0,8,0">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                    <Setter Property="ToolTip" Value="MAC address e.g. AA:BB:CC:DD:EE:FF" />
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                        <TextBox Grid.Column="2" x:Name="WolBroadcastBox" Text="192.168.0.255" FontFamily="Cascadia Mono, Consolas" Margin="0,0,8,0" />
                                        <Button Grid.Column="3" x:Name="WolButton" Content="Wake" Style="{StaticResource PrimaryButton}" MinWidth="74" Click="WolButton_Click" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Diagnostics -->
                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,12">
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="Diagnostics" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock Text="Quick system check and connection diagnostics."
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="12"
                                                   Margin="0,3,0,0"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button DockPanel.Dock="Right" Content="Run quick check" Padding="14,5" MinHeight="30" />
                                </DockPanel>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Latency" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                        <TextBlock Text="0.6 ms" FontWeight="SemiBold" FontSize="15" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Packet loss" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                        <TextBlock Text="0%" FontWeight="SemiBold" FontSize="15" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Clipboard" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                        <TextBlock Text="Linked" FontWeight="SemiBold" FontSize="15" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="Stability" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                        <TextBlock Text="Excellent" FontWeight="SemiBold" FontSize="15" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Visibility="Collapsed">
                                    <TextBlock x:Name="TrustStatusText" Text="No peer selected" />
                                    <ComboBox x:Name="PairingPeerCombo" DisplayMemberPath="DisplayText" />
                                    <TextBlock x:Name="PeerFingerprintText" Text="No discovered peer selected" />
                                    <TextBlock x:Name="LocalFingerprintText" Text="loading..." />
                                    <TextBlock x:Name="DevPinText" Text="------" />
                                    <Button x:Name="TrustPeerButton"
                                            Content="Trust Device"
                                            Click="TrustPeerButton_Click" />
                                    <Button x:Name="UnpinPeerButton"
                                            Content="Remove Trust"
                                            Click="UnpinPeerButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- DISPLAYS -->
                <ScrollViewer x:Name="DisplaysPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel MaxWidth="900" Margin="30,24,30,30">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,12">
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="Display routing" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock Text="Current local screen size and edge selection used for handoff." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Button DockPanel.Dock="Right" Content="Refresh" Click="RefreshButton_Click" Padding="14,4" MinHeight="30" />
                                </DockPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="0.9*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Windows IPv4" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                        <ComboBox x:Name="IpComboBox" Margin="0,4,0,0" SelectionChanged="CommandInput_Changed" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                        <TextBlock Text="Width" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                        <TextBox x:Name="WidthBox" Margin="0,4,0,0" TextChanged="CommandInput_Changed" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="8,0,8,0">
                                        <TextBlock Text="Height" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                        <TextBox x:Name="HeightBox" Margin="0,4,0,0" TextChanged="CommandInput_Changed" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Margin="8,0,0,0">
                                        <TextBlock Text="Side" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                        <ComboBox x:Name="SideComboBox" Margin="0,4,0,0" SelectionChanged="CommandInput_Changed">
                                            <ComboBoxItem Content="left" IsSelected="True" />
                                            <ComboBoxItem Content="right" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <TextBox x:Name="CommandBox"
                                         MinHeight="62"
                                         Margin="0,14,0,0"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         FontFamily="Cascadia Mono, Consolas"
                                         FontSize="12"
                                         VerticalScrollBarVisibility="Auto" />

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button x:Name="CopyCommandButton" Content="Copy" Click="CopyCommandButton_Click" MinWidth="80" Margin="0,0,8,0" />
                                    <TextBlock x:Name="CommandStatusText" Text="" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ACTIVITY -->
                <Grid x:Name="ActivityPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="28,18" Background="#101620" BorderBrush="{StaticResource BorderBrushFaint}" BorderThickness="0,0,0,1">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Activity" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Live event stream"
                                           Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Content="Clear" Click="ClearLogButton_Click" Padding="14,4" MinHeight="30" />
                        </DockPanel>
                    </Border>

                    <TextBox x:Name="LogBox"
                             Grid.Row="1"
                             Margin="28,16,28,28"
                             Padding="14"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="12"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Background="#080C12"
                             Foreground="#D5E2F0"
                             BorderBrush="{StaticResource BorderBrushSoft}" />
                </Grid>

                <!-- CLIPBOARD -->
                <Grid x:Name="ClipboardPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="28,18" Background="#101620" BorderBrush="{StaticResource BorderBrushFaint}" BorderThickness="0,0,0,1">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Clipboard history" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock x:Name="ClipboardHistorySubtitle" Text="" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Content="Refresh" Click="RefreshClipboardHistory_Click" Padding="14,4" MinHeight="30" />
                        </DockPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ClipboardHistoryList" Margin="28,16,28,28">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10" Padding="14" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushFaint}" BorderThickness="1" CornerRadius="8">
                                        <StackPanel>
                                            <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                                <TextBlock Text="{Binding KindLabel}" FontWeight="SemiBold" DockPanel.Dock="Left" />
                                                <TextBlock Text="{Binding TimeLabel}" Foreground="{StaticResource MutedBrush}" FontSize="11" DockPanel.Dock="Left" Margin="10,2,0,0" />
                                                <TextBlock Text="{Binding SizeLabel}" Foreground="{StaticResource DimBrush}" FontSize="11" DockPanel.Dock="Right" Margin="0,2,0,0" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Preview}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- SETTINGS -->
                <ScrollViewer x:Name="SettingsPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel MaxWidth="820" Margin="28,24,28,28">

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Privacy and safety" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12" />
                                <CheckBox x:Name="LockOnDisconnectCheck"
                                          Content="Lock workstation when KM link drops (5s silence)"
                                          Checked="LockOnDisconnectCheck_Changed"
                                          Unchecked="LockOnDisconnectCheck_Changed" />
                                <TextBlock Text="Triggers LockWorkStation() if no KM frames arrive for five seconds while in receive mode."
                                           Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="22,4,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="UDP KM shared secret" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,16,0,0" />
                                <PasswordBox x:Name="KmSharedSecretBox"
                                             Margin="0,4,0,0"
                                             PasswordChanged="CommandInput_Changed"
                                             FontFamily="Cascadia Mono, Consolas" />
                                <TextBlock Text="Leave blank for raw dev-mode KM frames. When set, receive mode requires BRKM HMAC-SHA256 envelopes and send mode wraps outgoing frames."
                                           Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="About" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                                <TextBlock Text="BarelyReal shares keyboard, mouse and clipboard between Mac and Windows over LAN."
                                           Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
                                <TextBlock Text="Pairing and TLS are coming next. mDNS auto-discovery advertises and finds BarelyReal peers on the LAN."
                                           Foreground="{StaticResource DimBrush}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
