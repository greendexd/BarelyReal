<Window x:Class="BarelyReal.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BarelyReal.App.Controls"
        Title="BarelyReal"
        Icon="Assets/BarelyReal.ico"
        Width="1100"
        Height="760"
        MinWidth="940"
        MinHeight="640"
        Background="#F3F3F3"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <!-- Brushes -->
        <SolidColorBrush x:Key="TextBrush" Color="#1A1A1A" />
        <SolidColorBrush x:Key="MutedBrush" Color="#5C5C5C" />
        <SolidColorBrush x:Key="DimBrush" Color="#8A8A8A" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#E0E0E0" />
        <SolidColorBrush x:Key="BorderBrushFaint" Color="#EAEAEA" />
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FAFAFA" />
        <SolidColorBrush x:Key="AccentBrush" Color="#0067C0" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#E5F1FB" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#107C10" />
        <SolidColorBrush x:Key="SuccessSoftBrush" Color="#E1F4E1" />
        <SolidColorBrush x:Key="WarningBrush" Color="#C19C00" />
        <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFF4CE" />
        <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C" />
        <SolidColorBrush x:Key="SidebarBrush" Color="#FAFAFA" />

        <!-- Card -->
        <Style x:Key="Card" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="20" />
        </Style>

        <Style x:Key="StatBadge" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushFaint}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,12" />
        </Style>

        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!-- Default button (subtle) -->
        <Style TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="root" Value="#F5F5F5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" TargetName="root" Value="#EDEDED" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary action button -->
        <Style x:Key="PrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="20,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              TextBlock.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="root" Value="#005AA8" />
                                <Setter Property="BorderBrush" TargetName="root" Value="#005AA8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" TargetName="root" Value="#004D90" />
                                <Setter Property="BorderBrush" TargetName="root" Value="#004D90" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              TextBlock.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="root" Value="#A8231A" />
                                <Setter Property="BorderBrush" TargetName="root" Value="#A8231A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" TargetName="root" Value="#8E1E15" />
                                <Setter Property="BorderBrush" TargetName="root" Value="#8E1E15" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar nav RadioButton styled as nav row -->
        <Style x:Key="NavRadio" TargetType="{x:Type RadioButton}">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="root"
                                CornerRadius="7"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border x:Name="indicator"
                                        Width="3"
                                        Height="18"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource AccentBrush}"
                                        CornerRadius="2"
                                        Visibility="Collapsed"
                                        Margin="-12,0,0,0" />
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="root" Value="#EDEDED" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" TargetName="root" Value="#E5E5E5" />
                                <Setter Property="Visibility" TargetName="indicator" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mode pill RadioButton -->
        <Style x:Key="PillRadio" TargetType="{x:Type RadioButton}">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="root"
                                CornerRadius="7"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="root" Value="#EDEDED" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" TargetName="root" Value="{StaticResource CardBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrushFaint}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <!-- App brand -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,22,20,18">
                    <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource AccentBrush}" Margin="0,0,12,0">
                        <TextBlock Text="BR" Foreground="White" FontWeight="Bold" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="BarelyReal" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock Text="Cross-device input" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <!-- Footer link status -->
                <Border DockPanel.Dock="Bottom" Padding="20,14" BorderBrush="{StaticResource BorderBrushFaint}" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="SidebarStatusDot" Width="9" Height="9" Fill="#BFBFBF" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="SidebarStatusText" Text="Stopped" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Nav items -->
                <StackPanel Margin="12,0">
                    <RadioButton x:Name="NavHome" Style="{StaticResource NavRadio}" GroupName="Nav" IsChecked="True" Checked="Nav_Changed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏠" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="Home" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavClipboard" Style="{StaticResource NavRadio}" GroupName="Nav" Checked="Nav_Changed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="Clipboard" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavActivity" Style="{StaticResource NavRadio}" GroupName="Nav" Checked="Nav_Changed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="Activity" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavRadio}" GroupName="Nav" Checked="Nav_Changed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="Settings" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Detail -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Grid.Row="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushFaint}" BorderThickness="0,0,0,1" Padding="28,16">
                <DockPanel LastChildFill="False">
                    <TextBlock x:Name="PageTitleText"
                               Text="Home"
                               FontSize="20"
                               FontWeight="SemiBold"
                               DockPanel.Dock="Left"
                               VerticalAlignment="Center" />
                    <Border DockPanel.Dock="Right" CornerRadius="14" Padding="10,6" Background="#F2F2F2" BorderBrush="{StaticResource BorderBrushFaint}" BorderThickness="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#BFBFBF" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText" Text="Stopped" FontWeight="Medium" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <!-- Pages -->
            <Grid Grid.Row="1">
                <!-- HOME -->
                <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto" Padding="0">
                    <StackPanel MaxWidth="820" Margin="28,24,28,28" HorizontalAlignment="Stretch">

                        <!-- Mode pill -->
                        <Border CornerRadius="9" Background="#ECECEC" Padding="3" HorizontalAlignment="Stretch" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <RadioButton x:Name="ModeReceiveRadio"
                                             GroupName="ModeGroup"
                                             IsChecked="True"
                                             Checked="ModeRadio_Changed"
                                             Style="{StaticResource PillRadio}"
                                             Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="↓" Margin="0,0,8,0" />
                                        <TextBlock Text="Mac → Windows" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="ModeSendRadio"
                                             GroupName="ModeGroup"
                                             Checked="ModeRadio_Changed"
                                             Style="{StaticResource PillRadio}"
                                             Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="↑" Margin="0,0,8,0" />
                                        <TextBlock Text="Windows → Mac" />
                                    </StackPanel>
                                </RadioButton>
                            </Grid>
                        </Border>

                        <!-- Status hero -->
                        <Border Style="{StaticResource Card}" Padding="24" CornerRadius="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="64" Height="64" CornerRadius="32" Background="{StaticResource AccentSoftBrush}" Margin="0,0,18,0">
                                    <TextBlock x:Name="HeroIcon" Text="◉" FontSize="32" Foreground="{StaticResource AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="HeroTitle" Text="Ready to receive from Mac" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock x:Name="HeroSubtitle"
                                               Text="Listening for incoming keyboard and mouse."
                                               Foreground="{StaticResource MutedBrush}"
                                               Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="StartButton" Content="Start" Style="{StaticResource PrimaryButton}" Click="StartButton_Click" Margin="0,0,8,0" MinWidth="92" />
                                    <Button x:Name="StopButton" Content="Stop" Style="{StaticResource DangerButton}" Click="StopButton_Click" MinWidth="92" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Connection card (per mode) -->
                        <Border x:Name="ReceiveCard" Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="📡" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Listening on this PC" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                </StackPanel>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Control" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="TCP " VerticalAlignment="Center" />
                                            <TextBox x:Name="ControlPortBox" Text="24800" Width="74" Padding="8,4" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                        <TextBlock Text="Keyboard &amp; mouse" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="UDP " VerticalAlignment="Center" />
                                            <TextBox x:Name="KmPortBox" Text="24801" Width="74" Padding="8,4" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Margin="8,0,8,0">
                                        <TextBlock Text="Clipboard" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="TCP " VerticalAlignment="Center" />
                                            <TextBox x:Name="ClipboardPortBox" Text="24802" Width="74" Padding="8,4" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Margin="8,0,0,0">
                                        <TextBlock Text="Mac IP (control/clipboard)" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                        <TextBox x:Name="ClipboardPeerBox" Text="192.168.0.101" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="SendCard" Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="🖥️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Send to Mac" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Move your cursor past the screen edge to control the Mac."
                                           Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,12" TextWrapping="Wrap" />

                                <controls:LayoutCanvas x:Name="LayoutDesigner" Margin="0,0,0,16" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Mac IP" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                        <TextBox x:Name="SendMacHostBox" Margin="0,4,0,0" Text="192.168.0.101" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="Mac KM port" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                        <TextBox x:Name="SendMacKmPortBox" Margin="0,4,0,0" Text="24801" />
                                    </StackPanel>
                                </Grid>

                                <Border Margin="0,16,0,0" Padding="14" CornerRadius="10" Background="#FFF8EC" BorderBrush="#F0E0BB" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="⚡ Wake Mac" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <TextBox Grid.Column="1" x:Name="WolMacBox" Text="" FontFamily="Cascadia Mono, Consolas" Margin="0,0,8,0">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                    <Setter Property="ToolTip" Value="MAC address e.g. AA:BB:CC:DD:EE:FF" />
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                        <TextBox Grid.Column="2" x:Name="WolBroadcastBox" Text="192.168.0.255" FontFamily="Cascadia Mono, Consolas" Margin="0,0,8,0" />
                                        <Button Grid.Column="3" x:Name="WolButton" Content="Wake" Style="{StaticResource PrimaryButton}" MinWidth="74" Click="WolButton_Click" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Quick stats -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource StatBadge}" Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="KM frames" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                    <TextBlock x:Name="FramesText" Text="0" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource StatBadge}" Margin="5,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="Clipboard events" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                    <TextBlock x:Name="ClipboardText" Text="0" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource StatBadge}" Margin="5,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Link" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                    <TextBlock x:Name="LinkText" Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock x:Name="FooterText" Text="" Foreground="{StaticResource DimBrush}" FontSize="12" Margin="2,16,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>

                <!-- ACTIVITY -->
                <Grid x:Name="ActivityPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="28,18" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushFaint}" BorderThickness="0,0,0,1">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Activity" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Live event stream"
                                           Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Content="Clear" Click="ClearLogButton_Click" Padding="14,4" MinHeight="30" />
                        </DockPanel>
                    </Border>

                    <TextBox x:Name="LogBox"
                             Grid.Row="1"
                             Margin="28,16,28,28"
                             Padding="14"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="12"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Background="#0F1417"
                             Foreground="#D7E2EA"
                             BorderBrush="#0F1417" />
                </Grid>

                <!-- CLIPBOARD -->
                <Grid x:Name="ClipboardPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="28,18" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushFaint}" BorderThickness="0,0,0,1">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Clipboard history" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock x:Name="ClipboardHistorySubtitle" Text="" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Content="Refresh" Click="RefreshClipboardHistory_Click" Padding="14,4" MinHeight="30" />
                        </DockPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ClipboardHistoryList" Margin="28,16,28,28">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10" Padding="14" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushFaint}" BorderThickness="1" CornerRadius="10">
                                        <StackPanel>
                                            <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                                <TextBlock Text="{Binding KindLabel}" FontWeight="SemiBold" DockPanel.Dock="Left" />
                                                <TextBlock Text="{Binding TimeLabel}" Foreground="{StaticResource MutedBrush}" FontSize="11" DockPanel.Dock="Left" Margin="10,2,0,0" />
                                                <TextBlock Text="{Binding SizeLabel}" Foreground="{StaticResource DimBrush}" FontSize="11" DockPanel.Dock="Right" Margin="0,2,0,0" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Preview}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- SETTINGS -->
                <ScrollViewer x:Name="SettingsPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel MaxWidth="820" Margin="28,24,28,28">

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="🛡  Privacy &amp; safety" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12" />
                                <CheckBox x:Name="LockOnDisconnectCheck"
                                          Content="Lock workstation when KM link drops (5s silence)"
                                          Checked="LockOnDisconnectCheck_Changed"
                                          Unchecked="LockOnDisconnectCheck_Changed" />
                                <TextBlock Text="Triggers LockWorkStation() if no KM frames arrive for five seconds while in receive mode."
                                           Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="22,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,12">
                                    <TextBlock Text="🛠  Tools" FontWeight="SemiBold" FontSize="14" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="Generate the Mac CLI command for power-user smoke testing."
                                           Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap" />

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="0.9*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Windows IPv4" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                        <ComboBox x:Name="IpComboBox" Margin="0,4,0,0" SelectionChanged="CommandInput_Changed" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                        <TextBlock Text="Width" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                        <TextBox x:Name="WidthBox" Margin="0,4,0,0" TextChanged="CommandInput_Changed" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="8,0,8,0">
                                        <TextBlock Text="Height" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                        <TextBox x:Name="HeightBox" Margin="0,4,0,0" TextChanged="CommandInput_Changed" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Margin="8,0,0,0">
                                        <TextBlock Text="Side" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                        <ComboBox x:Name="SideComboBox" Margin="0,4,0,0" SelectionChanged="CommandInput_Changed">
                                            <ComboBoxItem Content="left" IsSelected="True" />
                                            <ComboBoxItem Content="right" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <TextBox x:Name="CommandBox"
                                         MinHeight="62"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         FontFamily="Cascadia Mono, Consolas"
                                         FontSize="12"
                                         VerticalScrollBarVisibility="Auto" />

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button x:Name="CopyCommandButton" Content="Copy" Click="CopyCommandButton_Click" MinWidth="80" Margin="0,0,8,0" />
                                    <Button x:Name="RefreshButton" Content="Refresh IP list" Click="RefreshButton_Click" />
                                    <TextBlock x:Name="CommandStatusText" Text="" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="14,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="ℹ  About" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                                <TextBlock Text="BarelyReal — share keyboard, mouse and clipboard between Mac and Windows over LAN."
                                           Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
                                <TextBlock Text="Pairing, TLS and mDNS auto-discovery are coming next."
                                           Foreground="{StaticResource DimBrush}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
